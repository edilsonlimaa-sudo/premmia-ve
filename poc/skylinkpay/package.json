{
  "name": "skylinkpay-poc",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "POC de integración con SkyLinkPay: cliente firmado HMAC y receptor de webhook",
  "scripts": {
    "create": "node --env-file=.env create-transaction.js",
